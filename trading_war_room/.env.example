# Copy to .env and fill in only what you use. Nothing here is required for --demo or --smoke-test.
# Secrets live here, never in config.yaml.

# --- Market data / news (Alpaca paper account keys) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Must stay true. This project never routes real-money orders; the flag only selects Alpaca's paper data endpoints.
ALPACA_PAPER=true

# --- News ---
FINNHUB_API_KEY=

# --- LLM dialogue (optional; RuleBasedDialogueProvider is used when unset) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Notifications (optional) ---
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
